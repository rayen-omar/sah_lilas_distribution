<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_sah" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sah</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_uom_id']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="after">
                <field name="sah_qty_unit" optional="show"/>
                <field name="sah_price_unit" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="replace">
                <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="sah_total_discount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="sah_total_fodec" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                    <label for="amount_total"/>
                </div>
                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
