<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_inherit_sah" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sah</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_id']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="sah_qty_unit" optional="show"/>
                <field name="sah_price_unit" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
