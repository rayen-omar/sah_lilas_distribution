<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_sah" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.sah</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Déplacer l'Unité AVANT la Quantité -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="before">
                <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_id']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="sah_qty_unit" optional="show"/>
                <field name="sah_price_unit" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="replace">
                <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="sah_total_discount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="sah_total_fodec" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                    <label for="amount_total"/>
                </div>
                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
