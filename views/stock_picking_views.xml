<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_sah" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.sah</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']" position="before">
                <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity']" position="after">
                <field name="sah_qty_unit" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
