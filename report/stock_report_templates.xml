<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_inherit_sah" inherit_id="stock.report_delivery_document">
        <!-- Table stock_move_table (Operations) -->
        <xpath expr="//table[@name='stock_move_table']//th[@name='th_sm_quantity']" position="before">
            <th name="th_sah_qty_unit" class="text-end"><strong>Qté Unités</strong></th>
            <th name="th_sah_price_unit" class="text-end"><strong>PU Unité</strong></th>
        </xpath>

        <xpath expr="//table[@name='stock_move_table']//span[@t-out='format_number(move.quantity)']/.." position="before">
            <td name="td_sah_qty_unit" class="text-end">
                <span t-field="move.sah_qty_unit"/>
            </td>
            <td name="td_sah_price_unit" class="text-end">
                <span t-field="move.sah_price_unit"/>
            </td>
        </xpath>
    </template>
</odoo>
